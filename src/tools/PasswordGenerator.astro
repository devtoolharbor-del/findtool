---
/**
 * Password and passphrase generator.
 *
 * The generated value never leaves this element: it is not logged, not
 * written to storage, and not passed to track() — which only ever receives an
 * event name and the page's slug (see src/lib/toolkit.ts).
 *
 * Entropy is computed from the alphabet that was actually used, in
 * src/lib/random.ts, where the unbiased draw that makes the figure true is
 * also unit-tested.
 */
import type { Tool } from '~/types';
import ToolLayout from '~/layouts/ToolLayout.astro';

interface Props {
  tool: Tool;
}
const { tool } = Astro.props;
---

<ToolLayout tool={tool}>
  <div data-tool="password-generator" class="space-y-4">
    {/* ── Mode ── */}
    <fieldset>
      <legend class="bc-label">Mode</legend>
      <div class="bc-toolbar">
        <label class="bc-check-label">
          <input type="radio" name="pw-mode" value="password" class="bc-checkbox" checked />
          Random characters
        </label>
        <label class="bc-check-label">
          <input type="radio" name="pw-mode" value="passphrase" class="bc-checkbox" />
          Passphrase (words)
        </label>
      </div>
    </fieldset>

    {/* ── Character-password options ── */}
    <div data-panel="password" class="space-y-3">
      <div>
        <label for="pw-length" class="bc-label">
          Length: <output for="pw-length" data-length class="font-semibold text-ink">20</output>
          characters
        </label>
        <input
          id="pw-length"
          type="range"
          min="4"
          max="128"
          step="1"
          value="20"
          class="w-full accent-accent"
        />
      </div>

      <fieldset class="rounded-lg border border-line p-3">
        <legend class="px-1 text-xs font-medium tracking-wide text-muted uppercase">
          Characters to use
        </legend>
        <div class="bc-toolbar">
          <label class="bc-check-label">
            <input type="checkbox" class="bc-checkbox" data-opt="lowercase" checked />
            a–z
          </label>
          <label class="bc-check-label">
            <input type="checkbox" class="bc-checkbox" data-opt="uppercase" checked />
            A–Z
          </label>
          <label class="bc-check-label">
            <input type="checkbox" class="bc-checkbox" data-opt="digits" checked />
            0–9
          </label>
          <label class="bc-check-label">
            <input type="checkbox" class="bc-checkbox" data-opt="symbols" checked />
            Symbols
          </label>
        </div>
        <div class="bc-toolbar mt-2 border-t border-line pt-2">
          <label class="bc-check-label">
            <input type="checkbox" class="bc-checkbox" data-opt="excludeAmbiguous" />
            Exclude look-alikes (I l 1 | O 0 o 5 S 2 Z)
          </label>
          <label class="bc-check-label">
            <input type="checkbox" class="bc-checkbox" data-opt="noRepeats" />
            No repeated characters
          </label>
        </div>
      </fieldset>
    </div>

    {/* ── Passphrase options ── */}
    <div data-panel="passphrase" class="space-y-3" hidden>
      <div class="grid gap-3 sm:grid-cols-2">
        <div>
          <label for="pw-words" class="bc-label">
            Words: <output for="pw-words" data-words class="font-semibold text-ink">6</output>
          </label>
          <input
            id="pw-words"
            type="range"
            min="3"
            max="12"
            step="1"
            value="6"
            class="w-full accent-accent"
          />
        </div>
        <div>
          <label for="pw-separator" class="bc-label">Separator</label>
          <select id="pw-separator" class="bc-select">
            <option value="-" selected>Hyphen &nbsp;-</option>
            <option value=".">Full stop &nbsp;.</option>
            <option value="_">Underscore &nbsp;_</option>
            <option value=" ">Space</option>
            <option value="">None</option>
          </select>
        </div>
      </div>
      <div class="bc-toolbar">
        <label class="bc-check-label">
          <input type="checkbox" class="bc-checkbox" data-opt="capitalize" />
          Capitalise each word
        </label>
        <label class="bc-check-label">
          <input type="checkbox" class="bc-checkbox" data-opt="appendDigits" />
          Append four digits
        </label>
      </div>
    </div>

    {/* ── The value ── */}
    <div>
      <label for="pw-value" class="bc-label">Generated value</label>
      <div class="flex gap-2">
        <input
          id="pw-value"
          class="bc-input font-mono text-base"
          data-output
          readonly
          spellcheck="false"
          autocomplete="off"
          aria-describedby="pw-entropy"
        />
        <button type="button" class="bc-btn bc-btn-secondary shrink-0" data-copy="[data-output]">
          <span data-label>Copy</span>
        </button>
      </div>
    </div>

    <div class="bc-toolbar">
      <button type="button" class="bc-btn bc-btn-primary" data-generate>Generate</button>
      <button type="button" class="bc-btn bc-btn-secondary" data-clear>Clear</button>
    </div>

    <div id="pw-status" data-status role="status" aria-live="polite" hidden></div>

    {/* ── The honest numbers ── */}
    <div id="pw-entropy" class="grid grid-cols-2 gap-2 sm:grid-cols-3" data-stats hidden>
      <div class="bc-stat">
        <div class="bc-stat-value" data-stat-bits>—</div>
        <div class="bc-stat-label">Entropy (bits)</div>
      </div>
      <div class="bc-stat">
        <div class="bc-stat-value" data-stat-alphabet>—</div>
        <div class="bc-stat-label">Possible symbols</div>
      </div>
      <div class="bc-stat">
        <div class="bc-stat-value text-base" data-stat-crack>—</div>
        <div class="bc-stat-label">Average offline crack time</div>
      </div>
    </div>
    <p class="text-xs text-muted" data-assumption hidden>
      Crack time assumes an attacker who has stolen the password database and can test 10<sup
        >11</sup
      > guesses per second offline — a realistic figure for a few modern GPUs against a fast hash such
      as unsalted SHA-256. Against a correctly configured Argon2id it would be many orders of magnitude
      slower; against a rate-limited login form, slower still.
    </p>
  </div>

  <Fragment slot="content">
    <h2>What this tool does</h2>
    <p>
      It builds a password from characters, or a passphrase from words, drawing every choice from
      <code>crypto.getRandomValues()</code> with rejection sampling so that each symbol is exactly
      as likely as every other. Then it tells you what that is actually worth, in bits, rather than
      colouring a bar green.
    </p>
    <p>
      Nothing here is transmitted. The value is generated in this tab, never sent to a server,
      never written to <code>localStorage</code>, and gone when you close the page.
    </p>

    <h2>Common uses</h2>
    <ul>
      <li>A unique password for one account, pasted straight into a password manager.</li>
      <li>A database or service account credential that no human will ever have to type.</li>
      <li>A passphrase for a disk-encryption or SSH key that you <em>do</em> have to type.</li>
      <li>A shared secret for a webhook, where 128 bits costs nothing and removes a worry.</li>
    </ul>

    <h2>A short example</h2>
    <p>Twenty characters from all four classes, and the arithmetic behind it:</p>
    <pre><code>{`qR7vLm2Xd9Ktp4Zb6#w!

alphabet   26 + 26 + 10 + 27 = 89 symbols
entropy    20 x log2(89) = 129.5 bits
crack time 2^128.5 / 10^11 per second = 1.5 x 10^20 years`}</code></pre>
    <p>Do not use that one, or any other password printed on a public page.</p>

    <h2>Reading the entropy figure</h2>
    <p>
      Entropy here means log<sub>2</sub> of the number of passwords the settings can produce — not
      a guess about how clever the string looks. Twenty characters from the full 89-symbol set is
      20 × log<sub>2</sub>(89) ≈ 129 bits. Turning off symbols drops the alphabet to 62 and the
      total to about 119 bits. Switching on <em>no repeated characters</em> lowers it again,
      because the second character can no longer be any of 89 — the figure shown accounts for that
      by summing log<sub>2</sub>(89) + log<sub>2</sub>(88) + … rather than pretending otherwise.
    </p>
    <p>
      Useful reference points: 40 bits falls in hours, 60 bits is uncomfortable, 80 bits is fine
      for almost anything, and 128 bits is the point past which the algorithm around the password
      is the weak part.
    </p>

    <h2>Passphrases and the six-word rule</h2>
    <p>
      A passphrase drawn from this 250-word list carries log<sub>2</sub>(250) ≈ 7.97 bits per word,
      so six words is about 48 bits and ten words about 80 — weaker per word than the EFF's
      7,776-word Diceware list at 12.9 bits, which is the price of keeping every word short enough
      to type. Capitalising each word adds exactly nothing, because it is a fixed transformation an
      attacker applies too; the four-digit suffix adds 13.3 bits.
    </p>

    <h2>Worth knowing</h2>
    <p>
      Length beats character variety. A sixteen-character lowercase password has more entropy than
      an eight-character one using every symbol on the keyboard, and it survives contact with a
      terminal, a CSV file and a phone keyboard far better. Rotating a strong unique password on a
      schedule provides no security benefit — NIST SP 800-63B dropped that advice in 2017 — but
      changing one you suspect was exposed obviously does.
    </p>
  </Fragment>
</ToolLayout>

<script>
  import {
    mount,
    q,
    qa,
    on,
    setStatus,
    clearStatus,
    messageFor,
    wireCopyButtons,
    markUsed,
  } from '~/lib/toolkit';
  import {
    generatePassword,
    passwordAlphabet,
    passwordEntropyBits,
    generatePassphrase,
    passphraseEntropyBits,
    PASSPHRASE_WORDS,
    crackTimeSeconds,
    formatDuration,
  } from '~/lib/random';

  /** Stated out loud next to the number, because a crack time without an
   *  assumed rate is meaningless. */
  const GUESSES_PER_SECOND = 1e11;

  mount('password-generator', (root) => {
    const output = q<HTMLInputElement>('[data-output]', root)!;
    const stats = q('[data-stats]', root)!;
    const assumption = q('[data-assumption]', root)!;
    const lengthInput = q<HTMLInputElement>('#pw-length', root)!;
    const lengthOut = q('[data-length]', root)!;
    const wordsInput = q<HTMLInputElement>('#pw-words', root)!;
    const wordsOut = q('[data-words]', root)!;
    const separator = q<HTMLSelectElement>('#pw-separator', root)!;
    const opt = (name: string) => q<HTMLInputElement>(`[data-opt="${name}"]`, root)!;

    const mode = (): 'password' | 'passphrase' =>
      (q<HTMLInputElement>('input[name="pw-mode"]:checked', root)!.value as
        | 'password'
        | 'passphrase');

    const passwordOptions = () => ({
      length: Number(lengthInput.value),
      lowercase: opt('lowercase').checked,
      uppercase: opt('uppercase').checked,
      digits: opt('digits').checked,
      symbols: opt('symbols').checked,
      excludeAmbiguous: opt('excludeAmbiguous').checked,
      noRepeats: opt('noRepeats').checked,
    });

    const passphraseOptions = () => ({
      words: Number(wordsInput.value),
      separator: separator.value,
      capitalize: opt('capitalize').checked,
      appendDigits: opt('appendDigits').checked ? 4 : 0,
    });

    const showStats = (bits: number, symbols: number) => {
      stats.removeAttribute('hidden');
      assumption.removeAttribute('hidden');
      q('[data-stat-bits]', root)!.textContent = bits.toFixed(1);
      q('[data-stat-alphabet]', root)!.textContent = symbols.toLocaleString();
      q('[data-stat-crack]', root)!.textContent = formatDuration(
        crackTimeSeconds(bits, GUESSES_PER_SECOND),
      );
    };

    const generate = () => {
      try {
        if (mode() === 'password') {
          const opts = passwordOptions();
          const alphabet = passwordAlphabet(opts);
          // generatePassword raises a written-for-humans error for the empty
          // alphabet and the impossible no-repeat length; both surface below.
          output.value = generatePassword(opts);
          showStats(passwordEntropyBits(opts), new Set([...alphabet]).size);
        } else {
          const opts = passphraseOptions();
          output.value = generatePassphrase(opts);
          showStats(passphraseEntropyBits(opts), PASSPHRASE_WORDS.length);
        }
        clearStatus(root);
        markUsed();
      } catch (err) {
        output.value = '';
        stats.setAttribute('hidden', '');
        assumption.setAttribute('hidden', '');
        setStatus(root, messageFor(err), 'error');
      }
    };

    // Mode switch shows one panel and regenerates, so the field is never stale.
    for (const radio of qa<HTMLInputElement>('input[name="pw-mode"]', root)) {
      on(radio, 'change', () => {
        const isPassphrase = mode() === 'passphrase';
        q('[data-panel="password"]', root)!.toggleAttribute('hidden', isPassphrase);
        q('[data-panel="passphrase"]', root)!.toggleAttribute('hidden', !isPassphrase);
        generate();
      });
    }

    on(lengthInput, 'input', () => {
      lengthOut.textContent = lengthInput.value;
      generate();
    });
    on(wordsInput, 'input', () => {
      wordsOut.textContent = wordsInput.value;
      generate();
    });
    on(separator, 'change', generate);
    for (const name of [
      'lowercase',
      'uppercase',
      'digits',
      'symbols',
      'excludeAmbiguous',
      'noRepeats',
      'capitalize',
      'appendDigits',
    ]) {
      on(opt(name), 'change', generate);
    }

    on(q('[data-generate]', root), 'click', generate);
    on(q('[data-clear]', root), 'click', () => {
      output.value = '';
      stats.setAttribute('hidden', '');
      assumption.setAttribute('hidden', '');
      clearStatus(root);
    });

    wireCopyButtons(root);

    // A password generator that opens empty makes you click before you can
    // judge whether the settings are right.
    generate();
  });
</script>
