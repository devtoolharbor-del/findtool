---
/**
 * The ByteCabin mark.
 *
 * A pitched roof over a body carrying two horizontal lines of unequal length.
 * They read as the logs of a cabin wall and as lines of code at the same time,
 * which is the whole idea behind the name. The earlier version was a plain
 * house outline that people read as a generic "home" icon — the log lines and
 * the overhanging eaves are what make this one specific.
 *
 * Geometric, monochrome, and legible down to 16px.
 */
interface Props {
  size?: number;
  class?: string;
}
const { size = 26, class: className = '' } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.9"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
>
  <path d="M2.2 10.6 12 3.2l9.8 7.4" />
  <path d="M5.4 12.4v8.4h13.2v-8.4" />
  <path d="M8.2 15.4h7.6" />
  <path d="M8.2 18.2h4.6" />
</svg>
