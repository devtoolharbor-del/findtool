---
import { SITE } from '~/consts';
import BaseLayout from '~/layouts/BaseLayout.astro';
import ToolCard from '~/components/ToolCard.astro';
import Icon from '~/components/Icon.astro';
import { TOOLS, popularTools, recentlyAdded } from '~/data/tools';
import { sortedCategories } from '~/data/categories';
import { FEATURED } from '~/data/featured';
import { toolsInCategory } from '~/data/tools';

const popular = popularTools(8);
const categories = sortedCategories();
const recent = recentlyAdded();

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.name,
    url: SITE.url,
    description: SITE.description,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: SITE.name,
    url: SITE.url,
    logo: `${SITE.url}/icon-512.png`,
    description: SITE.description,
    /*
      Entity disambiguation: ties the name "FindTool" to a profile that
      demonstrably belongs to it. No controlled evidence that this moves
      rankings, but it is one line and it is true.
    */
    sameAs: ['https://github.com/devtoolharbor-del/findtool'],
  },
];
---

<BaseLayout
  title={`${SITE.name} — Fast Developer Tools That Run in Your Browser`}
  description={SITE.description}
  canonical="/"
  appendBrand={false}
  wide
  schema={schema}
>
  {/* ── Hero ───────────────────────────────────────────────────────────── */}
  <section class="py-12 text-center sm:py-16">
    <h1 class="mx-auto max-w-3xl text-3xl font-semibold tracking-tight sm:text-5xl">
      Developer tools that run in your browser
    </h1>
    <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted sm:text-lg">
      Fast, focused utilities for JSON, encoding, hashing, dates and text. No accounts,
      no uploads, nothing to install.
    </p>

    <div class="mx-auto mt-8 max-w-lg">
      <button
        type="button"
        data-search-open
        class="flex w-full items-center gap-3 rounded-xl border border-line-strong bg-surface px-4 py-3.5 text-left shadow-card transition-colors hover:border-accent-line"
      >
        <svg
          class="size-5 shrink-0 text-muted"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <circle cx="11" cy="11" r="7"></circle>
          <path d="m20 20-3.5-3.5"></path>
        </svg>
        <span class="flex-1 text-[0.95rem] text-muted">Search tools…</span>
        <kbd
          class="hidden rounded border border-line-strong px-1.5 py-0.5 font-sans text-[11px] text-muted sm:inline"
          >⌘K</kbd
        >
      </button>
    </div>

    {/* Deliberately outside the max-w-lg wrapper above: constrained to the
        search field's width, the sixth shortcut orphans onto its own row.

        On a return visit the script below replaces these shortcuts with the
        visitor's own recent tools. It reuses this row rather than adding a
        section so the swap costs nothing in layout shift. */}
    <div class="mx-auto mt-3 max-w-2xl">
      <p class="sr-only" data-shortcut-label>Popular tools</p>
      <ul class="flex flex-wrap justify-center gap-1.5" data-shortcuts>
        {
          FEATURED.map(({ label, slug }) => (
            <li>
              <a
                href={`/tools/${slug}`}
                class="inline-block rounded-full border border-line bg-surface px-3 py-1 text-xs text-muted transition-colors hover:border-accent-line hover:text-accent"
              >
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <script>
    import { readRecent } from '~/lib/recent';

    /**
     * Swap the hero shortcuts for the visitor's own recent tools.
     *
     * Names come from the search index rather than being embedded in the page,
     * so this costs nothing for a first-time visitor — the fetch only happens
     * when there is actually a history to show.
     */
    const recent = readRecent();
    const list = document.querySelector('[data-shortcuts]');
    const label = document.querySelector('[data-shortcut-label]');

    if (recent.length >= 2 && list) {
      fetch('/search.json')
        .then((r) => r.json())
        .then((index: { s: string; n: string }[]) => {
          const byslug = new Map(index.map((e) => [e.s, e.n]));
          const items = recent.filter((s) => byslug.has(s));
          if (items.length < 2) return;

          list.textContent = '';
          for (const slug of items) {
            const li = document.createElement('li');
            const a = document.createElement('a');
            a.href = `/tools/${slug}`;
            a.className =
              'inline-block rounded-full border border-accent-line bg-surface px-3 py-1 text-xs text-accent transition-colors hover:border-accent';
            // textContent, never innerHTML: the name comes from a fetched file.
            a.textContent = byslug.get(slug)!;
            li.appendChild(a);
            list.appendChild(li);
          }
          if (label) label.textContent = 'Tools you used recently';
        })
        .catch(() => {
          /* keep the default shortcuts */
        });
    }
  </script>

  {/* ── Popular ────────────────────────────────────────────────────────── */}
  <section aria-labelledby="popular-heading" class="pb-14">
    <div class="mb-4 flex items-baseline justify-between gap-4">
      <h2 id="popular-heading" class="text-lg font-semibold">Most used</h2>
      <a href="/tools" class="bc-tap text-sm font-medium text-accent hover:underline">
        All tools →
      </a>
    </div>
    <div class="bc-tool-grid">
      {popular.map((tool) => <ToolCard tool={tool} />)}
    </div>
  </section>

  {/* ── Categories ─────────────────────────────────────────────────────── */}
  <section aria-labelledby="cats-heading" class="pb-14">
    <h2 id="cats-heading" class="mb-4 text-lg font-semibold">Browse by category</h2>
    <div class="bc-tool-grid">
      {
        categories.map((c) => (
          <a href={`/${c.slug}`} class="bc-card group flex gap-3 hover:border-line-strong">
            <span class="mt-0.5 flex size-9 shrink-0 items-center justify-center rounded-lg border border-line bg-surface-2 text-muted transition-colors group-hover:border-accent-line group-hover:text-accent">
              <Icon name={c.icon} size={18} />
            </span>
            <span class="min-w-0 flex-1">
              <span class="flex items-baseline gap-2">
                <span class="text-[0.9375rem] font-medium text-ink group-hover:text-accent">
                  {c.name}
                </span>
              </span>
              <span class="mt-1 block text-sm leading-relaxed text-muted">{c.tagline}</span>
            </span>
          </a>
        ))
      }
    </div>
  </section>

  {/* ── Recently added — hidden until there is a genuine subset to show ── */}
  {
    recent.length > 0 && (
      <section aria-labelledby="recent-heading" class="pb-14">
        <h2 id="recent-heading" class="mb-4 text-lg font-semibold">
          Recently added
        </h2>
        <div class="bc-tool-grid">
          {recent.map((tool) => (
            <ToolCard tool={tool} />
          ))}
        </div>
      </section>
    )
  }

  {/* ── How it works ───────────────────────────────────────────────────── */}
  <section aria-labelledby="how-heading" class="border-t border-line py-12">
    <h2 id="how-heading" class="sr-only">How FindTool works</h2>
    <div class="grid gap-8 sm:grid-cols-3">
      <div>
        <h3 class="text-sm font-semibold text-ink">Nothing is uploaded</h3>
        <p class="mt-1.5 text-sm leading-relaxed text-muted">
          Every tool here runs as JavaScript in your own tab. The API response you paste, the
          token you decode and the password you generate never reach a FindTool server, because
          there is no server to reach.
        </p>
      </div>
      <div>
        <h3 class="text-sm font-semibold text-ink">No account, no limits</h3>
        <p class="mt-1.5 text-sm leading-relaxed text-muted">
          There is nothing to sign up for and no usage quota. Bookmark a tool, use it fifty times
          a day, and you will never see a login wall or a "upgrade to continue" prompt.
        </p>
      </div>
      <div>
        <h3 class="text-sm font-semibold text-ink">Built to stay fast</h3>
        <p class="mt-1.5 text-sm leading-relaxed text-muted">
          Pages are static HTML served from a CDN, with only the small amount of JavaScript a
          given tool actually needs. Most pages are interactive before a spinner would have had
          time to appear.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
