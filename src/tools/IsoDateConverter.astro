---
/**
 * ISO Date Converter — parse anything, then build one correctly.
 *
 * Half the page reads a pasted date in whatever format it arrives in and
 * renders it in every common one. The other half assembles an ISO 8601 /
 * RFC 3339 string from components, so the offset question has to be answered
 * explicitly rather than guessed at.
 */
import type { Tool } from '~/types';
import ToolLayout from '~/layouts/ToolLayout.astro';

interface Props {
  tool: Tool;
}
const { tool } = Astro.props;

const EXAMPLE = '2026-09-24T14:30:05.250+02:00';

const ROWS = [
  { key: 'interpretation', label: 'How it was read' },
  { key: 'iso-utc', label: 'ISO 8601 (UTC)' },
  { key: 'iso-offset', label: 'ISO 8601 (your offset)' },
  { key: 'rfc3339', label: 'RFC 3339' },
  { key: 'rfc2822', label: 'RFC 2822' },
  { key: 'basic', label: 'ISO basic format' },
  { key: 'week', label: 'ISO week date' },
  { key: 'ordinal', label: 'ISO ordinal date' },
  { key: 'epoch', label: 'Unix seconds' },
  { key: 'epoch-ms', label: 'Unix milliseconds' },
  { key: 'human', label: 'Readable' },
];
---

<ToolLayout tool={tool}>
  <div data-tool="iso-date-converter" class="space-y-6">
    {/* ── Parse ── */}
    <section class="space-y-3" aria-labelledby="iso-h-parse">
      <h2 id="iso-h-parse" class="text-sm font-semibold tracking-tight">Parse a date</h2>

      <div class="bc-toolbar">
        <div class="flex items-center gap-2">
          <label for="iso-naive" class="text-xs font-medium tracking-wide text-muted uppercase">
            No offset means
          </label>
          <select id="iso-naive" class="bc-select w-auto py-1.5 text-xs" data-naive-zone>
            <option value="UTC" selected>UTC</option>
            <option value="local">Your local zone</option>
          </select>
        </div>
        <div class="ml-auto flex flex-wrap gap-2">
          <button type="button" class="bc-btn bc-btn-secondary bc-btn-sm" data-now>Now</button>
          <button type="button" class="bc-btn bc-btn-secondary bc-btn-sm" data-example={EXAMPLE}>
            Example
          </button>
          <button type="button" class="bc-btn bc-btn-secondary bc-btn-sm" data-clear>Clear</button>
        </div>
      </div>

      <div>
        <label for="iso-input" class="bc-label">Date string, or a Unix timestamp</label>
        <input
          id="iso-input"
          type="text"
          autocomplete="off"
          spellcheck="false"
          class="bc-input font-mono"
          data-primary-input
          data-clear-target
          placeholder="2026-09-24T14:30:05Z"
          aria-describedby="iso-status"
        />
      </div>

      <div id="iso-status" data-status role="status" aria-live="polite" hidden></div>

      <div class="overflow-x-auto" data-results hidden>
        <table class="w-full text-sm">
          <caption class="sr-only">The same instant in every common format</caption>
          <tbody>
            {
              ROWS.map((row) => (
                <tr class="border-b border-line last:border-0">
                  <th
                    scope="row"
                    class="py-2 pr-3 text-left align-top text-xs font-medium tracking-wide whitespace-nowrap text-muted uppercase"
                  >
                    {row.label}
                  </th>
                  <td class="py-2 pr-2 align-top font-mono text-[0.8125rem] break-all">
                    <span data-out={row.key}>—</span>
                  </td>
                  <td class="w-px py-2 align-top">
                    <button
                      type="button"
                      class="bc-btn bc-btn-ghost bc-btn-sm"
                      data-copy={`[data-out="${row.key}"]`}
                      aria-label={`Copy ${row.label}`}
                    >
                      <span data-label>Copy</span>
                    </button>
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <textarea class="sr-only" data-output aria-hidden="true" tabindex="-1"></textarea>
    </section>

    <hr class="border-line" />

    {/* ── Build ── */}
    <section class="space-y-3" aria-labelledby="iso-h-build">
      <h2 id="iso-h-build" class="text-sm font-semibold tracking-tight">Build an ISO string</h2>

      <div class="grid grid-cols-2 gap-2 sm:grid-cols-3 lg:grid-cols-6">
        <div>
          <label for="iso-y" class="bc-label">Year</label>
          <input id="iso-y" type="number" class="bc-input" data-part="year" value="2026" min="0" max="9999" />
        </div>
        <div>
          <label for="iso-mo" class="bc-label">Month</label>
          <input id="iso-mo" type="number" class="bc-input" data-part="month" value="9" min="1" max="12" />
        </div>
        <div>
          <label for="iso-d" class="bc-label">Day</label>
          <input id="iso-d" type="number" class="bc-input" data-part="day" value="24" min="1" max="31" />
        </div>
        <div>
          <label for="iso-h" class="bc-label">Hour</label>
          <input id="iso-h" type="number" class="bc-input" data-part="hour" value="14" min="0" max="23" />
        </div>
        <div>
          <label for="iso-mi" class="bc-label">Minute</label>
          <input id="iso-mi" type="number" class="bc-input" data-part="minute" value="30" min="0" max="59" />
        </div>
        <div>
          <label for="iso-s" class="bc-label">Second</label>
          <input id="iso-s" type="number" class="bc-input" data-part="second" value="5" min="0" max="59" />
        </div>
      </div>

      <div class="bc-toolbar">
        <div class="flex items-center gap-2">
          <label for="iso-offset" class="text-xs font-medium tracking-wide text-muted uppercase">
            Offset
          </label>
          <select id="iso-offset" class="bc-select w-auto py-1.5 text-xs" data-build-offset>
            <option value="Z" selected>Z (UTC)</option>
            <option value="+00:00">+00:00 (UTC, written out)</option>
            <option value="local">Your current offset</option>
            <option value="-08:00">-08:00</option>
            <option value="-05:00">-05:00</option>
            <option value="+01:00">+01:00</option>
            <option value="+05:30">+05:30</option>
            <option value="+09:00">+09:00</option>
          </select>
        </div>
        <label class="bc-check-label">
          <input type="checkbox" class="bc-checkbox" data-build-ms />
          Include milliseconds
        </label>
        <label class="bc-check-label">
          <input type="checkbox" class="bc-checkbox" data-build-space />
          Space instead of T
        </label>
      </div>

      <div>
        <div class="mb-1.5 flex items-center justify-between">
          <span class="text-xs font-medium tracking-wide text-muted uppercase">Result</span>
          <button
            type="button"
            class="bc-btn bc-btn-secondary bc-btn-sm"
            data-copy="[data-built]"
            aria-label="Copy the built ISO string"
          >
            <span data-label>Copy</span>
          </button>
        </div>
        <output class="bc-output block font-mono text-base" data-built>—</output>
        <p class="mt-2 text-xs text-muted" data-built-note></p>
      </div>
    </section>
  </div>

  {/* ──────────────────────────────────────────────────────────────────── */}
  <Fragment slot="content">
    <h2>What this tool does</h2>
    <p>
      Paste a date in almost any shape — an ISO string, an email header date, a bare epoch
      number, something a database printed — and this page tells you which instant it names and
      rewrites it in every format you are likely to need. It also works the other way: set the
      components, choose an offset, and get a string a strict RFC 3339 parser will accept.
    </p>
    <p>
      It never silently guesses about the offset. If your input has no <code>Z</code> and no
      <code>+hh:mm</code>, the page says so and shows which zone it assumed, because that one
      decision is what moves a date by up to 26 hours.
    </p>

    <h2>Common uses</h2>
    <ul>
      <li>Turning a database <code>timestamptz</code> dump into a value an API will accept.</li>
      <li>
        Checking whether a string is genuinely RFC 3339 before sending it to a strict parser such
        as Go's <code>time.RFC3339</code> or a JSON Schema <code>format: date-time</code>.
      </li>
      <li>Working out which ISO week a date falls in for a reporting query.</li>
    </ul>

    <h2>A short example</h2>
    <p>Input:</p>
    <pre><code>Tue, 14 Nov 2023 22:13:20 +0000</code></pre>
    <p>Output:</p>
    <pre><code>{`ISO 8601 (UTC)   2023-11-14T22:13:20.000Z
ISO basic        20231114T221320Z
ISO week date    2023-W46-2
ISO ordinal      2023-318
Unix seconds     1700000000`}</code></pre>

    <h2>Z, +00:00, and the difference between ISO 8601 and RFC 3339</h2>
    <p>
      <code>Z</code> is short for "Zulu", the military name for the zero meridian. In
      <code>2026-09-24T14:30:05Z</code> it means the offset from UTC is zero. Writing
      <code>+00:00</code> names the same instant, so the two are interchangeable for arithmetic
      — but RFC 3339 §4.3 draws a distinction of intent: <code>-00:00</code> is reserved for
      "this is UTC, and the local offset is unknown", whereas <code>+00:00</code> asserts the
      local offset genuinely is zero. A real offset such as <code>+02:00</code> carries more
      still: it pins the instant <em>and</em> records what the clock said locally, which is why
      it beats <code>12:30:05Z</code> in an audit trail.
    </p>
    <p>
      RFC 3339 is a deliberately narrow profile of ISO 8601 for the internet. It requires a full
      date and time, requires an offset, and forbids most of ISO 8601's flexibility — no week
      dates, no ordinal dates, no omitted fields, no <code>20260924T143005</code> basic format.
      Practically everything RFC 3339 accepts is valid ISO 8601; a great deal of valid ISO 8601
      is not valid RFC 3339. RFC 3339 does permit a space in place of <code>T</code> by explicit
      agreement (§5.6); ISO 8601 does not.
    </p>

    <h2>Worth knowing</h2>
    <p>
      Offsets are not timezones. <code>+02:00</code> says the clock was two hours ahead of UTC at
      that moment; it does not say whether that was Berlin in summer or Cairo in winter, and it
      cannot say what the offset will be next March. For anything scheduled in the future, store
      the IANA zone name — <code>Europe/Berlin</code> — alongside the local time, because
      governments change DST rules with weeks of notice. An offset is right for an event that has
      already happened; a zone name is right for one that has not.
    </p>
  </Fragment>
</ToolLayout>

<script>
  import {
    mount,
    q,
    qa,
    on,
    setStatus,
    clearStatus,
    messageFor,
    guardSize,
    markUsed,
    wireStandardActions,
  } from '~/lib/toolkit';
  import {
    formatHuman,
    formatIsoInZone,
    formatIsoUtc,
    formatIsoWithOffset,
    formatOffset,
    formatRfc2822,
    isoWeekDate,
    localTimeZone,
    ordinalDate,
    parseDateTime,
    timestampIn,
    utcFromFields,
    zoneOffsetMinutes,
  } from '~/lib/datetime';

  mount('iso-date-converter', (root) => {
    const input = q<HTMLInputElement>('[data-primary-input]', root)!;
    const naiveZone = q<HTMLSelectElement>('[data-naive-zone]', root)!;
    const results = q('[data-results]', root)!;
    const mirror = q<HTMLTextAreaElement>('[data-output]', root)!;
    const built = q('[data-built]', root)!;
    const builtNote = q('[data-built-note]', root)!;
    const zone = localTimeZone();

    const out = (key: string, value: string) => {
      const el = q(`[data-out="${key}"]`, root);
      if (el) el.textContent = value;
    };

    // ── Parse ───────────────────────────────────────────────────────────
    const parse = () => {
      const text = input.value.trim();
      if (!text) {
        clearStatus(root);
        results.setAttribute('hidden', '');
        mirror.value = '';
        return;
      }

      try {
        guardSize(text);
        const target = naiveZone.value === 'local' ? zone : 'UTC';
        const parsed = parseDateTime(text, target);
        const ms = parsed.ms;

        results.removeAttribute('hidden');
        out('interpretation', parsed.note);
        out('iso-utc', formatIsoUtc(ms));
        out('iso-offset', `${formatIsoInZone(ms, zone, { milliseconds: true })}  (${zone})`);
        out('rfc3339', formatIsoUtc(ms, { milliseconds: false, zeroAsZ: false }));
        out('rfc2822', formatRfc2822(ms, 'UTC'));
        out('basic', formatIsoUtc(ms, { milliseconds: false }).replace(/[-:]/g, ''));
        out('week', isoWeekDate(ms));
        out('ordinal', ordinalDate(ms));
        out('epoch', timestampIn(ms, 'seconds'));
        out('epoch-ms', timestampIn(ms, 'milliseconds'));
        out('human', `${formatHuman(ms, 'UTC')} UTC`);

        mirror.value = qa('[data-out]', root)
          .map((el) => `${el.getAttribute('data-out')}: ${el.textContent}`)
          .join('\n');

        if (!parsed.hasOffset) {
          setStatus(
            root,
            `This string carries no offset, so it names a wall-clock reading rather than an instant. It was read as ${target} — switch "No offset means" if that is wrong.`,
            'warn',
          );
        } else if (parsed.kind === 'other') {
          setStatus(root, parsed.note, 'warn');
        } else {
          clearStatus(root);
        }
        markUsed();
      } catch (err) {
        results.setAttribute('hidden', '');
        mirror.value = '';
        setStatus(root, messageFor(err), 'error');
      }
    };

    // ── Build ───────────────────────────────────────────────────────────
    const part = (name: string): number =>
      Number(q<HTMLInputElement>(`[data-part="${name}"]`, root)!.value || '0');

    const build = () => {
      const year = part('year');
      const month = part('month');
      const day = part('day');
      const hour = part('hour');
      const minute = part('minute');
      const second = part('second');

      if (month < 1 || month > 12 || day < 1 || day > 31 || hour > 23 || minute > 59 || second > 59) {
        built.textContent = '—';
        builtNote.textContent =
          'Out of range. Months run 1–12, days 1–31, hours 0–23, minutes and seconds 0–59.';
        return;
      }

      const naive = utcFromFields(year, month, day, hour, minute, second);
      const choice = q<HTMLSelectElement>('[data-build-offset]', root)!.value;
      const offsetMinutes =
        choice === 'Z' || choice === '+00:00'
          ? 0
          : choice === 'local'
            ? zoneOffsetMinutes(naive, zone)
            : (Number(choice.slice(1, 3)) * 60 + Number(choice.slice(4))) * (choice[0] === '-' ? -1 : 1);

      const instant = naive - offsetMinutes * 60_000;
      const withMs = q<HTMLInputElement>('[data-build-ms]', root)!.checked;
      const spaced = q<HTMLInputElement>('[data-build-space]', root)!.checked;

      const text = formatIsoWithOffset(instant, offsetMinutes, {
        milliseconds: withMs,
        zeroAsZ: choice === 'Z',
        spaceSeparator: spaced,
      });
      built.textContent = text;

      const notes = [
        `That is ${formatIsoUtc(instant, { milliseconds: false })} in UTC.`,
        choice === 'local' ? `Your current offset is ${formatOffset(offsetMinutes)}.` : '',
        spaced ? 'A space instead of T is allowed by RFC 3339 §5.6 but not by ISO 8601.' : '',
      ].filter(Boolean);
      builtNote.textContent = notes.join(' ');
      markUsed();
    };

    on(input, 'input', parse);
    on(naiveZone, 'change', parse);
    for (const el of qa('[data-part], [data-build-offset], [data-build-ms], [data-build-space]', root)) {
      on(el, 'input', build);
      on(el, 'change', build);
    }

    on(q('[data-now]', root), 'click', () => {
      input.value = formatIsoUtc(Date.now());
      parse();
    });

    wireStandardActions(root, {
      onChange: () => {
        if (input.value) parse();
        else {
          results.setAttribute('hidden', '');
          mirror.value = '';
        }
      },
    });

    build();
  });
</script>
