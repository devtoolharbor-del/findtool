---
/**
 * Category pages, mounted at the root (/json, /encoding, …).
 *
 * Static routes such as /about take precedence over this dynamic route, and
 * getStaticPaths only emits the seven known category slugs, so there is no
 * risk of it swallowing another page.
 */
import { SITE } from '~/consts';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Breadcrumbs from '~/components/Breadcrumbs.astro';
import ToolCard from '~/components/ToolCard.astro';
import Icon from '~/components/Icon.astro';
import type { Category, Crumb } from '~/types';
import { CATEGORIES, sortedCategories } from '~/data/categories';
import { toolsInCategory } from '~/data/tools';

export function getStaticPaths() {
  return CATEGORIES.map((category) => ({
    params: { category: category.slug },
    props: { category },
  }));
}

interface Props {
  category: Category;
}

const { category } = Astro.props;
const tools = toolsInCategory(category.id);
const others = sortedCategories().filter((c) => c.id !== category.id);

const crumbs: Crumb[] = [{ label: 'Home', href: '/' }, { label: category.name }];

// BreadcrumbList comes from the Breadcrumbs component, which builds it from
// the same `crumbs` array this page renders.
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: `${category.name} tools`,
    numberOfItems: tools.length,
    itemListElement: tools.map((t, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: t.name,
      url: `${SITE.url}/tools/${t.slug}`,
    })),
  },
];
---

<BaseLayout
  title={category.seoTitle}
  description={category.seoDescription}
  canonical={`/${category.slug}`}
  ogImage={`/og/category-${category.id}.png`}
  wide
  schema={schema}
>
  <div class="py-6 sm:py-8">
    <Breadcrumbs items={crumbs} />

    <header class="mb-8 max-w-2xl">
      <div class="flex items-center gap-2.5">
        <span
          class="flex size-9 items-center justify-center rounded-xl border border-line bg-surface-2 text-accent"
          aria-hidden="true"
        >
          <Icon name={category.icon} size={19} />
        </span>
        <h1 class="text-2xl font-semibold tracking-tight sm:text-3xl">{category.name}</h1>
      </div>
      <p class="mt-4 text-[0.9375rem] leading-relaxed text-ink-soft" set:html={category.intro} />
      <p class="mt-3 text-sm text-muted">
      </p>
    </header>

    <div class="bc-tool-grid">
      {tools.map((tool) => <ToolCard tool={tool} showCategory={false} />)}
    </div>

    <section aria-labelledby="other-cats" class="mt-14 border-t border-line pt-8">
      <h2 id="other-cats" class="mb-4 text-base font-semibold">Other categories</h2>
      <ul class="flex flex-wrap gap-2">
        {
          others.map((c) => (
            <li>
              <a
                href={`/${c.slug}`}
                class="inline-flex items-center gap-1.5 rounded-lg border border-line bg-surface px-3 py-1.5 text-sm text-ink-soft transition-colors hover:border-accent-line hover:text-accent"
              >
                <Icon name={c.icon} size={15} />
                {c.name}
              </a>
            </li>
          ))
        }
        <li>
          <a
            href="/tools"
            class="inline-flex items-center rounded-lg border border-line bg-surface px-3 py-1.5 text-sm font-medium text-accent transition-colors hover:border-accent-line"
          >
            All tools →
          </a>
        </li>
      </ul>
    </section>
  </div>
</BaseLayout>
