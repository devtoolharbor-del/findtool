---
import BaseLayout from '~/layouts/BaseLayout.astro';
import ToolCard from '~/components/ToolCard.astro';
import Icon from '~/components/Icon.astro';
import { popularTools, TOOLS } from '~/data/tools';
import { sortedCategories } from '~/data/categories';

const popular = popularTools(6);
const categories = sortedCategories();
---

<BaseLayout
  title="Page not found"
  description="That page does not exist. Search ByteCabin's developer tools or browse by category."
  noindex
  wide
>
  <div class="py-14 sm:py-20">
    <div class="mx-auto max-w-lg text-center">
      <p class="text-sm font-medium tracking-widest text-accent uppercase">404</p>
      <h1 class="mt-3 text-2xl font-semibold tracking-tight sm:text-3xl">
        That page doesn't exist
      </h1>
      <p class="mt-3 text-[0.9375rem] leading-relaxed text-muted">
        The link may be out of date, or the tool may have been renamed. All {TOOLS.length} tools are
        still here — search for what you need, or browse the categories below.
      </p>

      <div class="mt-7 flex flex-col items-center justify-center gap-2 sm:flex-row">
        <button type="button" data-search-open class="bc-btn bc-btn-primary w-full sm:w-auto">
          <Icon name="search" size={16} />
          Search tools
        </button>
        <a href="/tools" class="bc-btn bc-btn-secondary w-full sm:w-auto">
          Browse all tools
        </a>
      </div>
    </div>

    <section aria-labelledby="popular-404" class="mt-14">
      <h2 id="popular-404" class="mb-4 text-center text-sm font-semibold text-muted">
        Popular tools
      </h2>
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {popular.map((tool) => <ToolCard tool={tool} />)}
      </div>
    </section>

    <nav aria-label="Categories" class="mt-10 flex flex-wrap justify-center gap-2">
      {
        categories.map((c) => (
          <a
            href={`/${c.slug}`}
            class="inline-flex items-center gap-1.5 rounded-lg border border-line bg-surface px-3 py-1.5 text-sm text-ink-soft transition-colors hover:border-accent-line hover:text-accent"
          >
            <Icon name={c.icon} size={15} />
            {c.name}
          </a>
        ))
      }
    </nav>
  </div>
</BaseLayout>
