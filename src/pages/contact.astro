---
import { SITE, CONTACT } from '~/consts';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Breadcrumbs from '~/components/Breadcrumbs.astro';
import type { Crumb } from '~/types';

const crumbs: Crumb[] = [{ label: 'Home', href: '/' }, { label: 'Contact' }];

const channels = [
  {
    address: CONTACT.general,
    title: 'General enquiries',
    body: 'Feedback, tool suggestions, partnership questions, or anything that does not fit the other two addresses.',
  },
  {
    address: CONTACT.support,
    title: 'Bug reports and tool problems',
    body: 'A tool giving the wrong answer, rejecting valid input, or failing in a particular browser. Including the input that caused it and the browser you used makes a fix much faster.',
  },
  {
    address: CONTACT.privacy,
    title: 'Privacy and data questions',
    body: 'Questions about the privacy policy, our analytics, or a data request.',
  },
];
---

<BaseLayout
  title="Contact ByteCabin"
  description="Get in touch with ByteCabin about tool suggestions, bug reports, or privacy questions. We read every message."
  canonical="/contact"
>
  <div class="py-6 sm:py-8">
    <Breadcrumbs items={crumbs} />
    <h1 class="text-2xl font-semibold tracking-tight sm:text-3xl">Contact</h1>
    <p class="mt-3 max-w-2xl text-[0.9375rem] leading-relaxed text-muted">
      ByteCabin has no contact form, because a form would need a server and this site deliberately
      does not have one. Email works better anyway — pick whichever address fits.
    </p>

    <div class="mt-8 space-y-3">
      {
        channels.map((c) => (
          <div class="bc-card">
            <h2 class="text-[0.9375rem] font-medium text-ink">{c.title}</h2>
            <p class="mt-1.5 text-sm leading-relaxed text-muted">{c.body}</p>
            <a
              href={`mailto:${c.address}`}
              class="bc-tap mt-3 inline-flex items-center gap-1.5 text-sm font-medium text-accent hover:underline"
            >
              <svg
                class="size-4"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.75"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <rect x="3" y="5" width="18" height="14" rx="2" />
                <path d="m3.5 7 8.5 6 8.5-6" />
              </svg>
              {c.address}
            </a>
          </div>
        ))
      }
    </div>

    <div class="bc-prose mt-10">
      <h2>Before you write about a broken tool</h2>
      <p>
        Two things resolve most reports immediately. First, a hard refresh
        (<kbd>⌘⇧R</kbd> or <kbd>Ctrl-F5</kbd>) clears a stale cached version of a page. Second,
        because everything runs client-side, a browser extension that blocks scripts can stop a
        tool working — trying the same page in a private window usually identifies that.
      </p>
      <p>
        If it still misbehaves, send us the tool name, the input that triggered it, what you
        expected, what happened instead, and your browser and version. Please redact anything
        sensitive from the input first — we do not need real tokens or customer data to reproduce
        a bug.
      </p>

      <h2>Response times</h2>
      <p>
        {SITE.name} is a small project. Expect a reply within a few days rather than a few hours.
        Bug reports that include a reproducible input are prioritised, because they are the ones
        we can act on straight away.
      </p>
    </div>
  </div>
</BaseLayout>
