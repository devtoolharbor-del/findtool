---
import { SITE } from '~/consts';
import { sortedCategories } from '~/data/categories';
import Logo from '~/components/Logo.astro';
import ThemeToggle from '~/components/ThemeToggle.astro';
import SearchDialog from '~/components/SearchDialog.astro';

const categories = sortedCategories();
const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(href + '/');
---

<header class="sticky top-0 z-40 border-b border-line bg-canvas/85 backdrop-blur-md">
  <div class="mx-auto flex h-14 max-w-6xl items-center gap-3 px-4 sm:px-6">
    <a
      href="/"
      class="flex shrink-0 items-center gap-2 text-ink"
      aria-label={`${SITE.name} home`}
    >
      <Logo size={24} class="text-accent" />
      <span class="text-[0.95rem] font-semibold tracking-tight">{SITE.name}</span>
    </a>

    {/* Two navs exist so desktop and mobile can differ structurally. They need
        distinct accessible names, or they collapse into one ambiguous landmark
        for screen-reader users (axe: landmark-unique). */}
    <nav aria-label="Tool categories" class="ml-2 hidden lg:block">
      <ul class="flex items-center gap-0.5">
        <li>
          <a
            href="/tools"
            class:list={[
              'rounded-md px-2.5 py-1.5 text-sm transition-colors hover:bg-surface-2',
              isActive('/tools') ? 'font-medium text-ink' : 'text-muted hover:text-ink',
            ]}>All tools</a
          >
        </li>
        {
          categories.map((c) => (
            <li>
              <a
                href={`/${c.slug}`}
                class:list={[
                  'rounded-md px-2.5 py-1.5 text-sm transition-colors hover:bg-surface-2',
                  isActive(`/${c.slug}`) ? 'font-medium text-ink' : 'text-muted hover:text-ink',
                ]}
              >
                {c.shortName}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="ml-auto flex items-center gap-2">
      <SearchDialog />
      <ThemeToggle />

      <details class="relative lg:hidden" name="bc-mobile-nav">
        <summary
          class="bc-btn bc-btn-ghost size-9 cursor-pointer list-none p-0 [&::-webkit-details-marker]:hidden"
          aria-label="Open navigation menu"
        >
          <svg
            class="size-5"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <path d="M4 7h16M4 12h16M4 17h16"></path>
          </svg>
        </summary>
        <nav
          aria-label="Tool categories, mobile menu"
          class="absolute right-0 mt-2 w-56 rounded-xl border border-line bg-surface p-1.5 shadow-lg"
        >
          <a
            href="/tools"
            class="block rounded-lg px-3 py-2 text-sm font-medium text-ink hover:bg-surface-2"
            >All tools</a
          >
          <div class="my-1.5 h-px bg-line"></div>
          {
            categories.map((c) => (
              <a
                href={`/${c.slug}`}
                class="block rounded-lg px-3 py-2 text-sm text-ink-soft hover:bg-surface-2"
              >
                {c.name}
              </a>
            ))
          }
        </nav>
      </details>
    </div>
  </div>
</header>

<script>
  // Close the mobile menu on outside click or Escape. `details` handles the
  // open/close state itself, so this is only the dismissal behaviour.
  document.addEventListener('click', (e) => {
    document.querySelectorAll<HTMLDetailsElement>('details[name="bc-mobile-nav"][open]').forEach(
      (d) => {
        if (!d.contains(e.target as Node)) d.open = false;
      },
    );
  });
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    document
      .querySelectorAll<HTMLDetailsElement>('details[name="bc-mobile-nav"][open]')
      .forEach((d) => (d.open = false));
  });
</script>
