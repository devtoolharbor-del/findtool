# ByteCabin environment variables
#
# Copy to `.env` for local use. `.env` is gitignored — never commit real values.
# In CI these live as GitHub Actions repository secrets; in Cloudflare Pages
# they live in the project's environment variable settings.
#
# NOTE: nothing here is required to run the site locally. Every tool works
# offline with no configuration. These only affect deployment and analytics.

# ─── Deployment (GitHub Actions secrets) ─────────────────────────────────
# Scoped API token with: Pages:Edit, Account Settings:Read, Zone:Read,
# DNS:Edit, Zone Settings:Edit, Email Routing:Edit, Transform Rules:Edit
CLOUDFLARE_API_TOKEN=

# Cloudflare account ID, visible in the dashboard sidebar on any zone
CLOUDFLARE_ACCOUNT_ID=

# ─── Analytics (build-time, public) ──────────────────────────────────────
# Cloudflare Web Analytics site token. Safe to expose — it is a public
# beacon identifier, not a credential. Leave empty to disable analytics
# entirely (useful for local development and preview deployments).
PUBLIC_CF_BEACON_TOKEN=

# Optional endpoint for anonymous custom events (tool_used, copy_clicked…).
# Leave empty and no event requests are made at all. The payload is only the
# event name and the tool slug — never user input.
PUBLIC_EVENTS_ENDPOINT=

# ─── Search engines ──────────────────────────────────────────────────────
# IndexNow key. Must match the filename served at /<key>.txt
INDEXNOW_KEY=
