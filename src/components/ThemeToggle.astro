---
/**
 * Light / dark toggle.
 *
 * Dark is the site default for everyone; the OS `prefers-color-scheme` is not
 * consulted. The inline bootstrap in BaseLayout resolves the theme before
 * first paint, and this stores an explicit choice in localStorage. Returning
 * to the default means clearing site data; a three-way control tested worse
 * than a simple switch, so this stays binary.
 */
import { SITE } from '~/consts';
---

<button
  type="button"
  id="bc-theme-toggle"
  class="bc-btn bc-btn-ghost size-9 p-0"
  data-theme-dark={SITE.themeColorDark}
  data-theme-light={SITE.themeColorLight}
  aria-label="Switch between light and dark theme"
  title="Switch theme"
>
  <svg
    class="size-[18px] dark:hidden"
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.75"
    stroke-linecap="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
    ></path>
  </svg>
  <svg
    class="hidden size-[18px] dark:block"
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.75"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5z"></path>
  </svg>
</button>

<script>
  const btn = document.getElementById('bc-theme-toggle');
  const root = document.documentElement;
  const meta = document.querySelector('meta[name="theme-color"]');
  /*
    The theme colours come from data attributes on the button, not from
    document.currentScript: Astro bundles this as a module, where
    currentScript is null and the tint would have been silently blanked.
  */
  const sync = (dark: boolean) => {
    btn?.setAttribute('aria-pressed', String(dark));
    const color = dark ? btn?.dataset.themeDark : btn?.dataset.themeLight;
    if (color) meta?.setAttribute('content', color);
  };

  // The bootstrap resolved the theme before this element existed, so the
  // button's initial state has to be read back rather than assumed.
  sync(root.classList.contains('dark'));

  btn?.addEventListener('click', () => {
    const dark = root.classList.toggle('dark');
    root.style.colorScheme = dark ? 'dark' : 'light';
    try {
      localStorage.setItem('bc-theme', dark ? 'dark' : 'light');
    } catch {
      /* private browsing: the toggle still works for this page view */
    }
    sync(dark);
  });
</script>
