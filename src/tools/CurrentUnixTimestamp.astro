---
/**
 * Current Unix Timestamp — a live clock in epoch form.
 *
 * Deliberately small: one interval, a handful of textContent writes, and a
 * pause button so a value can be copied without it moving underneath you.
 * The interval is cleared on pagehide so a backgrounded tab costs nothing.
 */
import type { Tool } from '~/types';
import ToolLayout from '~/layouts/ToolLayout.astro';

interface Props {
  tool: Tool;
}
const { tool } = Astro.props;

const ROWS = [
  { key: 'utc', label: 'UTC' },
  { key: 'local', label: 'Local time' },
  { key: 'iso', label: 'ISO 8601' },
  { key: 'rfc', label: 'RFC 2822' },
  { key: 'micros', label: 'Microseconds' },
  { key: 'week', label: 'ISO week / day of year' },
];
---

<ToolLayout tool={tool}>
  <div data-tool="current-unix-timestamp" class="space-y-4">
    {/* ── The two headline values ── */}
    <div class="grid gap-3 sm:grid-cols-2">
      <div class="bc-panel p-4">
        <div class="flex items-start justify-between gap-2">
          <div class="min-w-0">
            <div
              class="font-mono text-3xl font-semibold tabular-nums"
              data-value="seconds"
              aria-live="off">—</div>
            <div class="mt-1 text-xs tracking-wide text-muted uppercase">Seconds</div>
          </div>
          <button
            type="button"
            class="bc-btn bc-btn-secondary bc-btn-sm"
            data-copy='[data-value="seconds"]'
            aria-label="Copy the current timestamp in seconds"
          >
            <span data-label>Copy</span>
          </button>
        </div>
      </div>

      <div class="bc-panel p-4">
        <div class="flex items-start justify-between gap-2">
          <div class="min-w-0">
            <div
              class="font-mono text-3xl font-semibold tabular-nums"
              data-value="millis"
              aria-live="off">—</div>
            <div class="mt-1 text-xs tracking-wide text-muted uppercase">Milliseconds</div>
          </div>
          <button
            type="button"
            class="bc-btn bc-btn-secondary bc-btn-sm"
            data-copy='[data-value="millis"]'
            aria-label="Copy the current timestamp in milliseconds"
          >
            <span data-label>Copy</span>
          </button>
        </div>
      </div>
    </div>

    {/* ── Controls ── */}
    <div class="bc-toolbar">
      <button type="button" class="bc-btn bc-btn-primary" data-toggle aria-pressed="false">
        <span data-toggle-label>Pause</span>
      </button>
      <span class="text-xs text-muted" data-tick-note>Updating live, ten times a second.</span>
    </div>

    <div data-status role="status" aria-live="polite" hidden></div>

    {/* ── Formatted representations of the same instant ── */}
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <caption class="sr-only">The same moment in other formats</caption>
        <tbody>
          {
            ROWS.map((row) => (
              <tr class="border-b border-line last:border-0">
                <th
                  scope="row"
                  class="py-2 pr-3 text-left align-top text-xs font-medium tracking-wide whitespace-nowrap text-muted uppercase"
                >
                  {row.label}
                </th>
                <td class="py-2 pr-2 align-top font-mono text-[0.8125rem] break-all">
                  <span data-out={row.key}>—</span>
                </td>
                <td class="w-px py-2 align-top">
                  <button
                    type="button"
                    class="bc-btn bc-btn-ghost bc-btn-sm"
                    data-copy={`[data-out="${row.key}"]`}
                    aria-label={`Copy ${row.label}`}
                  >
                    <span data-label>Copy</span>
                  </button>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <p class="text-xs text-muted">
      Your clock reads <span data-zone class="font-mono">—</span>. The value comes from this
      device, so it is only as accurate as your system clock.
    </p>
  </div>

  {/* ──────────────────────────────────────────────────────────────────── */}
  <Fragment slot="content">
    <h2>What this tool does</h2>
    <p>
      This page shows the current Unix epoch time and keeps it moving, in seconds and in
      milliseconds, with the same instant repeated below in the formats you are likely to need
      next. Press Pause when you want to copy a value that will not change between reading it and
      pasting it — the clock freezes, both copy buttons keep working, and Resume picks the live
      value back up.
    </p>
    <p>
      The number is produced by <code>Date.now()</code> in your own browser. Nothing is fetched
      from a time server, which means the reading is exactly as correct as your operating
      system's clock and no more.
    </p>

    <h2>Common uses</h2>
    <ul>
      <li>
        Dropping a current timestamp into a seed file, a test fixture or a <code>curl</code>
        command without leaving the browser.
      </li>
      <li>
        Sanity-checking a value you just saw in a log: if it is wildly far from the number on
        this page, you are probably looking at the wrong unit.
      </li>
      <li>Setting a cache-busting query parameter or a one-off nonce by hand.</li>
      <li>
        Confirming a machine's clock drift — compare this against a server's <code>Date</code>
        response header.
      </li>
    </ul>

    <h2>A short example</h2>
    <p>The same moment, in the four representations this page shows:</p>
    <pre><code>{`seconds       1758724205
milliseconds  1758724205431
ISO 8601      2025-09-24T14:30:05.431Z
RFC 2822      Wed, 24 Sep 2025 14:30:05 +0000`}</code></pre>
    <p>
      Note that the seconds value is the millisecond value with the last three digits removed —
      truncated, never rounded. <code>Math.floor(Date.now() / 1000)</code> is the correct
      conversion; rounding would put you up to half a second in the future.
    </p>

    <h2>Why your clock can be wrong</h2>
    <p>
      Consumer machines drift by a few seconds a day and correct themselves through NTP, usually
      against <code>time.windows.com</code>, <code>time.apple.com</code> or a pool server. A
      virtual machine that has been suspended, a container on a host with no NTP client, or a
      device with a dead CMOS battery can be out by minutes or years. If a signature keeps
      failing validation or a JWT is rejected as "not yet valid", clock skew is worth ruling out
      before anything else — most token validators allow only 30 to 60 seconds of leeway.
    </p>

    <h2>Worth knowing</h2>
    <p>
      <code>Date.now()</code> is a wall-clock reading, so it can jump backwards when NTP corrects
      the machine. For measuring how long something took, use
      <code>performance.now()</code> instead — it is monotonic and unaffected by clock
      adjustments. Browsers also deliberately coarsen timer resolution as a side-channel defence:
      since Spectre, <code>Date.now()</code> has typically been rounded to the nearest
      millisecond or worse, and the microsecond row above is that millisecond value multiplied
      out, not genuine microsecond precision.
    </p>
  </Fragment>
</ToolLayout>

<script>
  import { mount, q, on, wireCopyButtons, markUsed } from '~/lib/toolkit';
  import {
    formatIsoUtc,
    formatHuman,
    formatOffset,
    formatRfc2822,
    formatShort,
    isoWeekDate,
    localTimeZone,
    ordinalDate,
    timestampIn,
    zoneInfo,
  } from '~/lib/datetime';

  /** Ten frames a second: smooth enough to read, cheap enough to ignore. */
  const TICK_MS = 100;

  mount('current-unix-timestamp', (root) => {
    const secondsEl = q('[data-value="seconds"]', root)!;
    const millisEl = q('[data-value="millis"]', root)!;
    const toggle = q('[data-toggle]', root)!;
    const toggleLabel = q('[data-toggle-label]', root)!;
    const note = q('[data-tick-note]', root)!;
    const zone = localTimeZone();

    const out = (key: string, value: string) => {
      const el = q(`[data-out="${key}"]`, root);
      if (el) el.textContent = value;
    };

    let lastSecond = -1;
    let timer: ReturnType<typeof setInterval> | null = null;
    let paused = false;

    const render = (now: number) => {
      millisEl.textContent = timestampIn(now, 'milliseconds');
      const second = Math.floor(now / 1000);
      if (second === lastSecond) return; // the slow rows only change once a second
      lastSecond = second;

      secondsEl.textContent = String(second);
      out('utc', `${formatShort(now, 'UTC')} UTC`);
      out('local', formatHuman(now, zone));
      out('iso', formatIsoUtc(now));
      out('rfc', formatRfc2822(now, 'UTC'));
      out('micros', timestampIn(now, 'microseconds'));
      out('week', `${isoWeekDate(now)} · day ${ordinalDate(now).split('-')[1]}`);
    };

    const start = () => {
      if (timer !== null || paused) return;
      render(Date.now());
      timer = setInterval(() => render(Date.now()), TICK_MS);
    };

    const stop = () => {
      if (timer === null) return;
      clearInterval(timer);
      timer = null;
    };

    on(toggle, 'click', () => {
      paused = !paused;
      toggle.setAttribute('aria-pressed', String(paused));
      toggleLabel.textContent = paused ? 'Resume' : 'Pause';
      note.textContent = paused
        ? 'Paused — the values above are frozen and safe to copy.'
        : 'Updating live, ten times a second.';
      if (paused) stop();
      else start();
    });

    // Stop the interval whenever the page is not visible, and always on
    // pagehide so a bfcache'd tab leaves nothing running.
    on(document, 'visibilitychange', () => (document.hidden ? stop() : start()));
    on(window, 'pagehide', stop);
    on(window, 'pageshow', start);

    wireCopyButtons(root);

    const info = zoneInfo(Date.now(), zone);
    q('[data-zone]', root)!.textContent = `${zone} (${formatOffset(info.offsetMinutes)}${
      info.dst ? ', daylight saving' : ''
    })`;

    start();
    markUsed();
  });
</script>
