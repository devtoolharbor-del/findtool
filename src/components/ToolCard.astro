---
import type { Tool } from '~/types';
import { CATEGORY_MAP } from '~/data/categories';
import Icon from '~/components/Icon.astro';

interface Props {
  tool: Tool;
  /** Show the category badge — off on category pages where it is redundant. */
  showCategory?: boolean;
  /** Marks the link as coming from a related-tools block, for analytics. */
  fromRelated?: boolean;
}

const { tool, showCategory = true, fromRelated = false } = Astro.props;
const category = CATEGORY_MAP[tool.category];
---

<a
  href={`/tools/${tool.slug}`}
  class="bc-card group flex gap-3 hover:border-line-strong"
  data-related={fromRelated ? '' : undefined}
>
  <span
    class="mt-0.5 flex size-9 shrink-0 items-center justify-center rounded-lg border border-line bg-surface-2 text-muted transition-colors group-hover:border-accent-line group-hover:text-accent"
  >
    <Icon name={tool.icon} size={18} />
  </span>

  <span class="min-w-0 flex-1">
    <span class="flex items-start justify-between gap-2">
      <span class="line-clamp-2 text-[0.9375rem] leading-normal font-medium text-ink group-hover:text-accent">
        {tool.name}
      </span>
      {
        showCategory && category && (
          <span class="mt-0.5 shrink-0 rounded border border-line px-1.5 py-0.5 text-[10px] whitespace-nowrap text-muted">
            {category.shortName}
          </span>
        )
      }
    </span>
    {/*
      Exactly three lines, always.

      `grid-auto-rows: 1fr` on .bc-tool-grid equalises rows within one grid,
      but /tools renders a separate grid per category, so a section whose
      longest description wrapped to four lines rendered 174px cards directly
      above a section of 129px ones. Letting the text decide the height means
      the card size depends on which neighbours it happens to have.

      Reserving three lines and clamping to three makes every tool card
      identical at every breakpoint and on every page. A registry test keeps
      descriptions short enough that the clamp never actually truncates.

      Below 360px — narrower than any current phone — three lines is not
      enough for the longest descriptions, so a fourth is allowed there. The
      arbitrary breakpoint is deliberate: reserving four lines everywhere
      would add a blank line to every card on every ordinary phone to serve a
      width almost nobody has.
    */}
    <span
      class="mt-1 line-clamp-3 min-h-[calc(3*1.625em)] text-sm leading-relaxed text-muted max-[359px]:line-clamp-4 max-[359px]:min-h-[calc(4*1.625em)]"
      >{tool.description}</span
    >
  </span>
</a>
