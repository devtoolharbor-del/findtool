---
/**
 * The local-processing guarantee.
 *
 * Rendered only when `tool.serverProcessing === false`. If a future tool ever
 * needs a server, this component must not appear on it — the claim has to stay
 * literally true everywhere it is shown.
 */
import { LOCAL_PROCESSING_NOTE } from '~/consts';

interface Props {
  extra?: string;
}
const { extra } = Astro.props;
---

<aside
  class="mt-4 flex gap-2.5 rounded-lg border border-line bg-surface-2 px-3.5 py-3 text-sm text-muted"
>
  <svg
    class="mt-0.5 size-4 shrink-0 text-accent"
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.75"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M12 3 5 6v6c0 4.2 2.9 7.8 7 9 4.1-1.2 7-4.8 7-9V6z"></path>
    <path d="m9.5 12 2 2 3.5-4"></path>
  </svg>
  <p class="leading-relaxed">
    <strong class="font-medium text-ink-soft">{LOCAL_PROCESSING_NOTE}</strong>
    {extra && <span class="mt-1 block">{extra}</span>}
  </p>
</aside>
