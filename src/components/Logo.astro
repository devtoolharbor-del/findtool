---
/**
 * The FindTool mark.
 *
 * A magnifier whose lens holds a terminal chevron: "find" and "developer" in
 * one shape. The chevron is what stops it reading as a generic search icon —
 * at 24px the lens and the prompt are still distinguishable.
 *
 * Geometric, monochrome, and legible down to 16px.
 */
interface Props {
  size?: number;
  class?: string;
}
const { size = 26, class: className = '' } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.9"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
>
  <circle cx="10.5" cy="10.5" r="6.8" />
  <path d="M15.6 15.6 20.9 20.9" />
  <path d="M8.9 8.1 11.4 10.5 8.9 12.9" />
</svg>
